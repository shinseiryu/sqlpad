{
  "name": "sqlpad",
  "version": "8.0.0",
  "description": "Web app. Write SQL and visualize the results. Supports Postgres, MySQL, SQL Server, ClickHouse, Trino, Presto, SAP HANA, BigQuery and SQLite.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "keywords": [
    "sql",
    "mssql",
    "drill",
    "postgres",
    "postgresql",
    "mysql",
    "presto",
    "sap",
    "hana",
    "bigquery",
    "bq"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinseiryu/sqlpad.git"
  },
  "bugs": {
    "url": "https://github.com/shinseiryu/sqlpad/issues"
  },
  "scripts": {
    "prepublishOnly": "cd .. && ./scripts/build.sh",
    "start": "node --watch server.js --config ./config.dev.env | pino-pretty",
    "test": "mocha test --timeout 20000 --recursive --exit --bail",
    "testmssql": "env SQLPAD_BACKEND_DB_URI='mssql://sa:SuperP4ssw0rd!@localhost:1433/dbname' npm run test",
    "testmysql": "env SQLPAD_BACKEND_DB_URI='mysql://root:root@localhost:23306/db2' npm run test",
    "testmariadb": "env SQLPAD_BACKEND_DB_URI='mariadb://root:password@localhost:13306/db?autoJsonMap=false' npm run test",
    "testpostgres": "env SQLPAD_BACKEND_DB_URI='postgres://sqlpad:sqlpad@localhost:5432/sqlpad' npm run test",
    "fixlint": "eslint --fix \"**/*.js\" && prettier --write .",
    "lint": "eslint \"**/*.js\" && prettier --check ."
  },
  "dependencies": {
    "@clickhouse/client": "^1.25.0",
    "@google-cloud/bigquery": "^9.6.1",
    "@node-saml/passport-saml": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-redis": "^10.0.0",
    "connect-session-sequelize": "^8.0.6",
    "cryptr": "^6.4.0",
    "detect-port": "^1.6.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "format-link-header": "^3.1.1",
    "hdb": "^2.30.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^9.2.0",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.3",
    "mariadb": "^3.5.5",
    "memorystore": "^1.6.8",
    "moo": "^0.5.3",
    "mssql": "^12.7.14",
    "mustache": "^4.2.0",
    "mysql2": "^3.24.6",
    "openid-client": "^6.9.0",
    "papaparse": "^5.7.1",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "query-string": "^9.5.1",
    "redis": "^6.3.1",
    "sanitize-filename": "^1.6.5",
    "sequelize": "^6.37.8",
    "serve-favicon": "^2.5.1",
    "session-file-store": "^1.5.0",
    "socks": "^2.8.10",
    "sql-formatter": "^15.9.0",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "main": "./app.js",
  "bin": {
    "sqlpad": "server.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bytes": "^3.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "parse-link-header": "^2.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "traverse": "^0.6.14"
  }
}
